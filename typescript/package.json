{
  "name": "@dcid/server-sdk",
  "version": "0.1.0",
  "description": "DCID Server SDK - Authentication and OTP methods",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dcid",
    "sdk",
    "authentication",
    "otp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^18.15.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}

