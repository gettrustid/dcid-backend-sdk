# TrustID API Configuration
TRUSTID_API_KEY=your-api-key-here
TRUSTID_ENVIRONMENT=dev

# Base URL override (optional)
# For Docker: use host.docker.internal to access KrakenD on host/other containers
# For local: use localhost
TRUSTID_BASE_URL=http://host.docker.internal:5000/api

# Server Configuration
PORT=8080



